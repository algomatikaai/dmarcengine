# DMARCEngine Production Environment Variables
# This file contains production-specific public configuration
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL
# Only public keys and non-sensitive configuration should be here

# SITE CONFIGURATION (Production URLs)
NEXT_PUBLIC_SITE_URL=https://dmarcengine.com

# SUPABASE - Production Database (Public keys only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# STRIPE - Production Billing (Public key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# MONITORING - Production
NEXT_PUBLIC_MONITORING_PROVIDER=sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# SECURITY (Public configuration)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_captcha_site_key

# FEATURE FLAGS - Production Settings
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_DELETION=false
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_DELETION=false
NEXT_PUBLIC_DISPLAY_TERMS_AND_CONDITIONS_CHECKBOX=true
STRIPE_ENABLE_TRIAL_WITHOUT_CC=false

# BRANDING - DMARCEngine Theme
NEXT_PUBLIC_THEME_COLOR=violet
NEXT_PUBLIC_THEME_COLOR_DARK=violet
